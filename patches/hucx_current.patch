index 0000000..e2d6ef2
--- /dev/null
+++ b/src/uct/urma/rm_urma/rm_urma_iface.h
@@ -0,0 +1,91 @@
+#ifndef UCT_RM_URMA_IFACE_H
+#define UCT_RM_URMA_IFACE_H
+#include <uct/urma/base/urma_md.h>
+#include <uct/base/uct_iface.h>
+#include <ucs/sys/math.h>
+#include "rm_urma_reliable.h"
+typedef struct uct_rm_urma_ep uct_rm_urma_ep_t;
+typedef struct rm_op rm_op_t;
+typedef struct rm_peer rm_peer_t;
+typedef struct {
+    uct_iface_config_t super;
+    unsigned rx_depth, tx_depth, priority, retries, max_peers;
+    size_t max_buffered;
+    double timeout, completion_timeout;
+    int native_rma, trace;
+    int diag;
+    /* Test-only receive drops; zero leaves normal communication unchanged. */
+    unsigned test_drop_data;
+    unsigned test_drop_ack;
+} uct_rm_urma_config_t;
+typedef struct { void *buffer; urma_target_seg_t *seg; int posted; } rm_recv_t;
+/* Optional counters observe software progress, not hardware queue occupancy. */
+typedef struct {
+    int active;
+    unsigned slow_logs;
+    int error_logged;
+    int failure_summary;
+    uint64_t last_exit;
+    uint64_t calls, rx_records, tx_records, rx_full, tx_full;
+    uint64_t reposts, repost_errors, repost_max;
+    uint64_t registers, register_ticks, register_max;
+    uint64_t unregisters, unregister_ticks, unregister_max;
+    uint64_t gap_max, progress_max;
+    uint64_t phase_max[6];
+} rm_diag_t;
+typedef struct uct_rm_urma_iface {
+    uct_base_iface_t super;
+    uct_ub_md_t *md;
+    urma_jfc_t *tx_cq, *rx_cq;
+    urma_jfr_t *jfr;
+    urma_jetty_t *jetty;
+    rm_address_t address;
+    uct_rm_urma_config_t config;
+    rm_recv_t *recv;
+    rm_op_t *ops;
+    rm_peer_t *peers;
+    uct_rm_urma_ep_t *eps;
+    uint64_t next_id, retry_ticks, completion_ticks;
+    unsigned inflight, peer_count, op_count;
+    unsigned test_drop_data_remaining;
+    unsigned test_drop_ack_remaining;
+    size_t buffered;
+    ucs_status_t failed;
+    int in_progress;
+    rm_diag_t diag;
+} uct_rm_urma_iface_t;
+struct rm_peer {
+    rm_peer_t *next;
+    rm_address_t address;
+    uint64_t stream;
+    urma_target_jetty_t *target;
+    rm_rx_state_t rx;
+    int ack_pending;
+};
+struct rm_op {
+    rm_op_t *next;
+    uint64_t id, seq, sent;
+    unsigned attempts;
+    int inflight, acked, kind;
+    uct_rm_urma_ep_t *ep;
+    urma_target_jetty_t *target;
+    void *buffer;
+    size_t length;
+    urma_target_seg_t *seg, *remote_seg;
+    urma_sge_t local, remote;
+    urma_opcode_t opcode;
+    uct_completion_t *comp;
+    uct_unpack_callback_t unpack;
+    void *unpack_arg;
+};
+UCS_CLASS_DECLARE(uct_rm_urma_iface_t, uct_md_h, uct_worker_h,
+                  const uct_iface_params_t *, const uct_iface_config_t *);
+unsigned uct_rm_urma_iface_progress(void *);
+ucs_status_t rm_post_recv(uct_rm_urma_iface_t *, unsigned);
+ucs_status_t rm_post_op(uct_rm_urma_iface_t *, rm_op_t *);
+rm_op_t *rm_op_alloc(uct_rm_urma_iface_t *, size_t);
+void rm_op_release(uct_rm_urma_iface_t *, rm_op_t *);
+void rm_ep_fail(uct_rm_urma_ep_t *, ucs_status_t);
+urma_target_seg_t *rm_register(uct_rm_urma_iface_t *, void *, size_t);
+extern uct_iface_ops_t uct_rm_urma_ops;
+#endif
diff --git a/src/uct/urma/rm_urma/rm_urma_reliable.c b/src/uct/urma/rm_urma/rm_urma_reliable.c
new file mode 100644
index 0000000..b6c5caa
--- /dev/null
+++ b/src/uct/urma/rm_urma/rm_urma_reliable.c
@@ -0,0 +1,59 @@
+#include "rm_urma_reliable.h"
+#include <stdlib.h>
+#include <string.h>
+#include <endian.h>
+#include <arpa/inet.h>
+
+int rm_rx_push(rm_rx_state_t *rx, uint64_t seq, uint8_t id, const void *data,
+               size_t length, rm_deliver_cb_t cb, void *arg)
+{
+    rm_rx_slot_t *slot;
+    if (!seq || length > RM_PAYLOAD_MAX || (!data && length)) return -1;
+    if (seq <= rx->delivered) return 1; /* ACK loss: don't deliver twice. */
+    if (seq - rx->delivered > RM_WINDOW) return -1;
+    slot = &rx->slots[seq % RM_WINDOW];
+    if (slot->seq == seq) return 1;
+    if (slot->seq) return -1;
+    slot->data = malloc(length ? length : 1);
+    if (!slot->data) return -2;
+    if (length) memcpy(slot->data, data, length);
+    slot->length = length;
+    rx->buffered += length;
+    slot->am_id = id;
+    slot->seq = seq;
+    while (rx->delivered != UINT64_MAX) {
+        slot = &rx->slots[(rx->delivered + 1) % RM_WINDOW];
+        if (slot->seq != rx->delivered + 1) break;
+        cb(arg, slot->am_id, slot->data, slot->length);
+        rx->delivered++;
+        rx->buffered -= slot->length;
+        free(slot->data);
+        memset(slot, 0, sizeof(*slot));
+    }
+    return 0;
+}
+void rm_rx_cleanup(rm_rx_state_t *rx)
+{
+    unsigned i;
+    for (i = 0; i < RM_WINDOW; ++i) free(rx->slots[i].data);
+    memset(rx, 0, sizeof(*rx));
+}
+int rm_ack_valid(uint64_t ack, uint64_t issued) { return ack <= issued; }
+int rm_retry_due(uint64_t now, uint64_t sent, uint64_t base, unsigned attempts)
+{
+    unsigned shift = attempts > 5 ? 5 : attempts;
+    uint64_t wait = base > (UINT64_MAX >> shift) ? UINT64_MAX : base << shift;
+    return now >= sent && now - sent >= wait;
+}
+int rm_header_valid(const rm_header_t *h, size_t n, uint64_t destination)
+{
+    return n >= sizeof(*h) && n <= RM_PACKET_MAX &&
+           ntohl(h->magic) == RM_MAGIC && h->version == RM_VERSION &&
+           !h->reserved && (h->type == RM_DATA || h->type == RM_ACK) &&
+           ntohl(h->source.magic) == RM_MAGIC &&
+           ntohs(h->source.version) == RM_VERSION &&
+           ntohs(h->source.mtu) == RM_PACKET_MAX &&
+           be64toh(h->destination) == destination &&
+           be64toh(h->source.cookie) && be64toh(h->stream) &&
+           (h->type != RM_ACK || n == sizeof(*h));
+}
diff --git a/src/uct/urma/rm_urma/rm_urma_reliable.h b/src/uct/urma/rm_urma/rm_urma_reliable.h
new file mode 100644
index 0000000..33f967d
--- /dev/null
+++ b/src/uct/urma/rm_urma/rm_urma_reliable.h
@@ -0,0 +1,48 @@
+/* RM+CTP experimental transport. See LICENSE for terms. */
+#ifndef UCT_RM_URMA_RELIABLE_H
+#define UCT_RM_URMA_RELIABLE_H
+#include <stdint.h>
+#include <stddef.h>
+#define RM_WINDOW 64u
+#define RM_PACKET_MAX 4096u
+#define RM_MAGIC 0x524d4354u
+#define RM_VERSION 1u
+#define RM_CAP_RMA 1u
+#define RM_DATA 1u
+#define RM_ACK 2u
+/* Explicit network byte order; never transmit compiler bitfields or pointers. */
+typedef struct __attribute__((packed)) {
+    uint32_t magic;
+    uint16_t version, mtu;
+    uint8_t eid[16];
+    uint32_t uasid, jetty, token, caps;
+    uint64_t cookie;
+} rm_address_t;
+typedef struct __attribute__((packed)) {
+    uint32_t magic;
+    uint8_t version, type, am_id, reserved;
+    uint64_t stream, seq, ack, destination;
+    rm_address_t source;
+} rm_header_t;
+_Static_assert(sizeof(rm_address_t) == 48, "RM wire address size");
+_Static_assert(sizeof(rm_header_t) == 88, "RM wire header size");
+#define RM_PAYLOAD_MAX (RM_PACKET_MAX - sizeof(rm_header_t))
+typedef struct {
+    uint64_t seq;
+    uint8_t am_id;
+    size_t length;
+    void *data;
+} rm_rx_slot_t;
+typedef struct {
+    uint64_t delivered;
+    size_t buffered;
+    rm_rx_slot_t slots[RM_WINDOW];
+} rm_rx_state_t;
+typedef void (*rm_deliver_cb_t)(void *, uint8_t, void *, size_t);
+int rm_rx_push(rm_rx_state_t *, uint64_t, uint8_t, const void *, size_t,
+               rm_deliver_cb_t, void *);
+void rm_rx_cleanup(rm_rx_state_t *);
+int rm_ack_valid(uint64_t ack, uint64_t issued);
+int rm_retry_due(uint64_t now, uint64_t sent, uint64_t base, unsigned attempts);
+int rm_header_valid(const rm_header_t *, size_t length, uint64_t destination);
+#endif
diff --git a/src/uct/urma/rm_urma/rm_urma_wireup.c b/src/uct/urma/rm_urma/rm_urma_wireup.c
new file mode 100644
index 0000000..f145da6
--- /dev/null
+++ b/src/uct/urma/rm_urma/rm_urma_wireup.c
@@ -0,0 +1,158 @@
+#include "rm_urma_wireup.h"
+#include "rm_urma_ep.h"
+#include <arpa/inet.h>
+#include <endian.h>
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+
+int rm_address_valid(const rm_address_t *a)
+{
+    return ntohl(a->magic) == RM_MAGIC && ntohs(a->version) == RM_VERSION &&
+           ntohs(a->mtu) == RM_PACKET_MAX && ntohl(a->jetty) && be64toh(a->cookie);
+}
+urma_target_jetty_t *rm_import(uct_rm_urma_iface_t *iface, const rm_address_t *a)
+{
+    urma_rjetty_t r = {0};
+    urma_token_t token = {.token = ntohl(a->token)};
+    memcpy(&r.jetty_id.eid, a->eid, 16);
+    r.jetty_id.uasid = ntohl(a->uasid);
+    r.jetty_id.id = ntohl(a->jetty);
+    r.trans_mode = URMA_TM_RM;
+    r.tp_type = URMA_CTP;
+    r.type = URMA_JETTY;
+    return urma_import_jetty(iface->md->dev.urma_ctx, &r, &token);
+}
+static void rm_deliver(void *arg, uint8_t id, void *data, size_t n)
+{
+    uct_rm_urma_iface_t *iface = arg;
+    uct_iface_invoke_am(&iface->super, id, data, n, 0);
+}
+/* Drop after header/session/sender validation, before any protocol state
+ * changes. RX progress still reposts the consumed hardware receive buffer. */
+static int rm_test_drop_packet(uct_rm_urma_iface_t *iface,
+                               const rm_header_t *header)
+{
+    unsigned *remaining;
+    const char *packet_type;
+
+    if (header->type == RM_DATA) {
+        remaining = &iface->test_drop_data_remaining;
+        packet_type = "DATA";
+    } else if (header->type == RM_ACK) {
+        remaining = &iface->test_drop_ack_remaining;
+        packet_type = "ACK";
+    } else {
+        return 0;
+    }
+
+    if (*remaining == 0) {
+        return 0;
+    }
+
+    --*remaining;
+    ucs_info("RM_CTP_TEST_DROP type=%s stream=%" PRIu64
+             " seq=%" PRIu64 " ack=%" PRIu64 " remaining=%u",
+             packet_type, be64toh(header->stream), be64toh(header->seq),
+             be64toh(header->ack), *remaining);
+    return 1;
+}
+
+void rm_receive(uct_rm_urma_iface_t *iface, const void *buffer, size_t n,
+                const urma_jetty_id_t *sender)
+{
+    rm_header_t h;
+    rm_peer_t *p;
+    rm_op_t *op;
+    uint64_t seq;
+    size_t before, length;
+    if (n < sizeof(h)) {
+        if (iface->config.trace) ucs_info("RM_CTP_DROP reason=short_header bytes=%zu", n);
+        return;
+    }
+    memcpy(&h, buffer, sizeof(h));
+    if (!rm_header_valid(&h, n, be64toh(iface->address.cookie)) ||
+        !rm_address_valid(&h.source)) {
+        if (iface->config.trace) ucs_info("RM_CTP_DROP reason=wire_format_or_session bytes=%zu", n);
+        return;
+    }
+    /* The advertised return address must match the device's receive completion. */
+    if (memcmp(h.source.eid, &sender->eid, 16) ||
+        ntohl(h.source.uasid) != sender->uasid || ntohl(h.source.jetty) != sender->id) {
+        if (iface->config.trace)
+            ucs_info("RM_CTP_DROP reason=sender_identity header_jetty=%u cq_jetty=%u header_uasid=%u cq_uasid=%u eid_match=%d",
+                     ntohl(h.source.jetty), sender->id, ntohl(h.source.uasid), sender->uasid,
+                     !memcmp(h.source.eid, &sender->eid, 16));
+        return;
+    }
+    if (rm_test_drop_packet(iface, &h)) {
+        return;
+    }
+    if (h.type == RM_ACK) {
+        uct_rm_urma_ep_t *ep;
+        for (ep = iface->eps; ep; ep = ep->next) {
+            if (ep->stream != be64toh(h.stream) ||
+                memcmp(&ep->remote, &h.source, sizeof(h.source))) continue;
+            if (!rm_ack_valid(be64toh(h.ack), ep->issued)) return;
+            for (op = iface->ops; op; op = op->next)
+                if (op->ep == ep && op->kind == RM_DATA && op->seq <= be64toh(h.ack)) op->acked = 1;
+            return;
+        }
+        return;
+    }
+    if (h.am_id >= UCT_AM_ID_MAX) return;
+    for (p = iface->peers; p; p = p->next)
+        if (p->stream == be64toh(h.stream) && !memcmp(&p->address, &h.source, sizeof(h.source))) break;
+    if (!p) {
+        if (iface->peer_count >= iface->config.max_peers) {
+            if (iface->config.trace) ucs_info("RM_CTP_DROP reason=max_receive_streams");
+            return;
+        }
+        p = calloc(1, sizeof(*p));
+        if (!p) return;
+        p->address = h.source;
+        p->stream = be64toh(h.stream);
+        p->target = rm_import(iface, &p->address);
+        if (!p->target) {
+            if (iface->config.trace) ucs_info("RM_CTP_DROP reason=return_address_import jetty=%u", ntohl(h.source.jetty));
+            free(p); return;
+        }
+        p->next = iface->peers; iface->peers = p; iface->peer_count++;
+    }
+    seq = be64toh(h.seq); length = n - sizeof(h);
+    if (iface->config.trace && (seq <= p->rx.delivered)) {
+        ucs_info("RM_CTP_DUPLICATE stream=%" PRIu64 " seq=%" PRIu64
+                 " delivered=%" PRIu64, p->stream, seq, p->rx.delivered);
+    }
+    /* Reserve no unbounded heap for missing packets. A gap-filling packet may
+     * temporarily exceed the budget by one payload; it immediately drains RX. */
+    if (seq > p->rx.delivered && seq - p->rx.delivered > 1 &&
+        !p->rx.slots[seq % RM_WINDOW].seq &&
+        length > iface->config.max_buffered - iface->buffered) {
+        p->ack_pending = 1;
+        return;
+    }
+    before = p->rx.buffered;
+    if (rm_rx_push(&p->rx, seq, h.am_id,
+                   (const char *)buffer + sizeof(h), n - sizeof(h), rm_deliver, iface) >= 0)
+        p->ack_pending = 1;
+    iface->buffered = iface->buffered - before + p->rx.buffered;
+}
+void rm_progress_acks(uct_rm_urma_iface_t *iface)
+{
+    rm_peer_t *p;
+    rm_op_t *op;
+    rm_header_t *h;
+    for (p = iface->peers; p; p = p->next) {
+        if (!p->ack_pending || iface->inflight >= iface->config.tx_depth) continue;
+        op = rm_op_alloc(iface, sizeof(*h));
+        if (!op) return;
+        op->kind = RM_ACK; op->target = p->target;
+        h = op->buffer;
+        h->magic = htonl(RM_MAGIC); h->version = RM_VERSION; h->type = RM_ACK;
+        h->stream = htobe64(p->stream); h->ack = htobe64(p->rx.delivered);
+        h->destination = p->address.cookie; h->source = iface->address;
+        if (rm_post_op(iface, op) == UCS_OK) p->ack_pending = 0;
+        else rm_op_release(iface, op);
+    }
+}
