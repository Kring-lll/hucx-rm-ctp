+++ b/contrib/rm_ctp/build_host.sh
@@ -0,0 +1,60 @@
+#!/usr/bin/env bash
+# Compile/test only: generates a deliberately nonfunctional mock SDK.
+set -euo pipefail
+if [ "$#" -ne 2 ]; then echo "usage: $0 UMDK_SOURCE NEW_ABSOLUTE_STAGE" >&2; exit 2; fi
+root=$(cd "$(dirname "$0")/../.." && pwd)
+umdk=$(realpath -e "$1")
+stage=$(realpath -m "$2")
+case "$stage" in "$root"|"$root"/*) echo 'STOP: stage must be outside source' >&2; exit 2;; esac
+if [ -e "$stage" ] || [ -L "$stage" ]; then echo 'STOP: stage exists' >&2; exit 2; fi
+headers="$umdk/src/urma/lib/urma/core/include"
+test -f "$headers/urma_api.h"
+printf '#include <infiniband/verbs.h>\n' | ${CC:-gcc} -x c -fsyntax-only -
+mkdir "$stage"
+mkdir -p "$stage/sdk/include" "$stage/sdk/lib" "$stage/source" "$stage/build"
+cp "$headers/"*.h "$stage/sdk/include/"
+tar -C "$root" --exclude='./.git' --exclude='./autom4te.cache' -cf - . | tar -C "$stage/source" -xf -
+python3 - "$stage" <<'PY'
+import pathlib,re,sys
+stage=pathlib.Path(sys.argv[1]); include=stage/'sdk/include'
+api=re.sub(r'/\*.*?\*/','', (include/'urma_api.h').read_text(),flags=re.S)
+prototypes={name:(ret,args) for ret,name,args in re.findall(r'^\s*(\w+(?:\s*\*+)?)\s*(urma_\w+)\s*\(([^;{}]*?)\)\s*;',api,flags=re.M)}
+needed=set()
+for p in (stage/'source/src/uct/urma').rglob('*'):
+    if p.suffix in ('.c','.h'):
+        needed.update(re.findall(r'\b(urma_\w+)\s*\(',p.read_text()))
+missing=needed-prototypes.keys()
+if missing: raise SystemExit('Missing API prototypes: '+str(sorted(missing)))
+code=['#include <urma_api.h>','#include <stddef.h>']
+for name in sorted(needed):
+    ret,args=prototypes[name]
+    value='return;' if ret=='void' else ('return NULL;' if '*' in ret else 'return ('+ret+')-1;')
+    code.append(ret+' '+name+'('+args+') { '+value+' }')
+(stage/'sdk/stubs.c').write_text('\n'.join(code)+'\n')
+(stage/'sdk/NOT_A_REAL_SDK.txt').write_text('Compilation shim only. Every URMA operation fails. Never deploy these libraries to a node.\n')
+print('MOCK_API_SYMBOLS='+str(len(needed)))
+PY
+${CC:-gcc} -shared -fPIC -Werror -Wno-unused-parameter -I"$stage/sdk/include" \
+    "$stage/sdk/stubs.c" -o "$stage/sdk/lib/liburma.so"
+printf 'int rm_ctp_mock_common;\n' | ${CC:-gcc} -shared -fPIC -x c - -o "$stage/sdk/lib/liburma_common.so"
+(cd "$stage/source" && ./autogen.sh) > "$stage/autogen.log" 2>&1
+if [ "${HUCX_SANITIZE:-0}" = 1 ]; then
+    # Public UCX wire packing/mpool/list helpers trigger these two checks.
+    # The standalone reliable core keeps the full sanitizer set.
+    cflags='-O1 -g -fsanitize=address,undefined -fno-sanitize=alignment,pointer-overflow -fno-omit-frame-pointer -Wno-error=format-truncation'
+    ldflags='-fsanitize=address,undefined'
+else cflags='-O2 -g'; ldflags=''; fi
+export ASAN_OPTIONS="${ASAN_OPTIONS:-detect_leaks=1}"
+export UBSAN_OPTIONS="${UBSAN_OPTIONS:-halt_on_error=1:print_stacktrace=1}"
+(cd "$stage/build" && CFLAGS="$cflags" CXXFLAGS="$cflags" LDFLAGS="$ldflags" LIBS='-lstdc++ -lrt' \
+    ../source/configure --prefix="$stage/host-install" --with-ub="$stage/sdk" \
+    --without-java --without-cuda --without-rocm --without-verbs --without-rdmacm) > "$stage/configure.log" 2>&1
+make -C "$stage/build" -j"${HUCX_JOBS:-4}" > "$stage/build.log" 2>&1
+export LD_LIBRARY_PATH="$stage/sdk/lib:${LD_LIBRARY_PATH-}"
+"$stage/source/contrib/rm_ctp/test_software.sh" > "$stage/reliable-test.log" 2>&1
+"$stage/source/contrib/rm_ctp/test_transport.sh" "$stage/build" "$stage/sdk/include" > "$stage/transport-test.log" 2>&1
+"$stage/source/contrib/rm_ctp/test_ucp.sh" "$stage/build" "$stage/sdk/include" > "$stage/ucp-test.log" 2>&1
+printf 'HOST_COMPILE_AND_SOFTWARE_TESTS_OK=%s\n' "$stage"
+tail -n 1 "$stage/reliable-test.log"
+tail -n 1 "$stage/transport-test.log"
+tail -n 1 "$stage/ucp-test.log"
diff --git a/contrib/rm_ctp/build_isolated.sh b/contrib/rm_ctp/build_isolated.sh
new file mode 100755
index 0000000..3180a95
--- /dev/null
+++ b/contrib/rm_ctp/build_isolated.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+# Fresh source/build/install only. Never writes the existing node installation.
+set -euo pipefail
+if [ "$#" -ne 1 ]; then echo "usage: $0 NEW_ABSOLUTE_STAGE_UNDER_LAB_EXPERIMENTS" >&2; exit 2; fi
+source_root=$(cd "$(dirname "$0")/../.." && pwd -P)
+lab=$(realpath -e "${HUCX_LAB:-/home/y00993710/urma_rm_ctp_lab}")
+target=$(realpath -m "$1")
+case "$target" in "$lab"/experiments/*) ;; *) echo "STOP: target must be under $lab/experiments" >&2; exit 2;; esac
+case "$target" in "$source_root"|"$source_root"/*) echo 'STOP: target must be outside the source tree' >&2; exit 2;; esac
+if [ -e "$target" ] || [ -L "$target" ]; then echo 'STOP: target already exists' >&2; exit 2; fi
+for command_name in gcc g++ make autoconf automake libtoolize flex tar; do
+    command -v "$command_name" >/dev/null || { echo "MISSING: $command_name" >&2; exit 2; }
+done
+jobs=${HUCX_JOBS:-4}
+if [[ ! "$jobs" =~ ^[1-9][0-9]*$ ]] || [ "$jobs" -gt 64 ]; then echo 'STOP: HUCX_JOBS must be 1..64' >&2; exit 2; fi
+mkdir -- "$target" # atomic refusal if another process created the directory
+mkdir "$target/source" "$target/build"
+trap 'code=$?; if [ "$code" -ne 0 ]; then printf "BUILD_FAILED exit=%s stage=%s\n" "$code" "$target" >&2; fi' EXIT
+tar -C "$source_root" --exclude='./.git' --exclude='./autom4te.cache' -cf - . |
+    tar -C "$target/source" -xf -
+{
+    date -u '+UTC=%Y-%m-%dT%H:%M:%SZ'
+    uname -a
+    gcc --version | head -n 1
+    sha256sum "$target/source/contrib/rm_ctp/BASELINES.json"
+    printf 'URMA_PREFIX=%s\n' "${HUCX_URMA_PREFIX:-/usr}"
+} > "$target/build_environment.txt"
+(cd "$target/source" && ./autogen.sh) > "$target/autogen.log" 2>&1
+(cd "$target/build" && CC="${CC:-gcc}" CXX="${CXX:-g++}" \
+    CFLAGS="${CFLAGS:--O2 -g}" CXXFLAGS="${CXXFLAGS:--O2 -g}" \
+    ../source/configure --prefix="$target/install" \
+    --with-ub="${HUCX_URMA_PREFIX:-/usr}" --without-java --without-cuda \
+    --without-rocm --without-verbs --without-rdmacm) > "$target/configure.log" 2>&1
+# The public UM source still includes verbs.h even with --without-verbs.
+# It must be supplied by the installed SDK/build dependencies; never auto-install them.
+grep -Eq '^module_LTLIBRARIES[[:space:]]*=[[:space:]]*libuct_ub\.la' \
+    "$target/build/src/uct/urma/Makefile" || { echo 'STOP: URMA module not configured' >&2; exit 1; }
+make -C "$target/build" -j"$jobs" > "$target/build.log" 2>&1
+install_prefix=$(sed -n 's/^prefix = //p' "$target/build/Makefile")
+if [ "$install_prefix" != "$target/install" ] || [ -e "$target/install" ] || [ -L "$target/install" ]; then
+    echo 'STOP: installation prefix or existing target check failed' >&2; exit 1
+fi
+make -C "$target/build" install > "$target/install.log" 2>&1
+${CC:-gcc} -std=gnu11 -D_DEFAULT_SOURCE -Wall -Wextra -Werror \
+    -I"$target/install/include" "$target/source/contrib/rm_ctp/acceptance.c" \
+    -L"$target/install/lib" -Wl,-rpath,"$target/install/lib" -lucp -lucs \
+    -o "$target/install/bin/rm_ctp_acceptance" > "$target/acceptance_build.log" 2>&1
+sha256sum "$target/install/lib/ucx/libuct_ub.so.0.0.0" \
+    "$target/install/lib/libucp.so.0.0.0" "$target/install/bin/rm_ctp_acceptance" > "$target/install_hashes.txt"
+printf 'BUILD_INSTALL_OK=%s\n' "$target"
+cat "$target/install_hashes.txt"
